# =====================================================================
# DedSec CCTV auth server - configuration. Copy to .env, chmod 600.
# NEVER commit your real .env. In ENVIRONMENT=production the server
# refuses to start while any value still contains CHANGE_ME.
# =====================================================================

# --- core ---
ENVIRONMENT=production                      # development | production | test
DATABASE_URL=sqlite:///./auth.db            # or postgresql+psycopg://user:pass@host:5432/dbname

# --- JWT access tokens ---
# Generate: python3 -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME
JWT_ISSUER=dedsec-cctv-server               # any string; must match what your client expects
JWT_AUDIENCE=dedsec-cctv
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- TOTP 2FA ---
# Generate: python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=CHANGE_ME
TOTP_ISSUER=DedSecCCTV                      # name shown in authenticator apps
LOGIN_CHALLENGE_TTL_SECONDS=300
LOGIN_CHALLENGE_MAX_ATTEMPTS=5

# --- brute-force protection ---
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
RATE_LIMIT_IP_PER_MINUTE=20
RATE_LIMIT_ACCOUNT_PER_15MIN=10
TRUST_PROXY_HEADERS=false                   # true ONLY behind your own reverse proxy (Caddy/nginx)

# --- email (verification codes, device-reset codes) ---
EMAIL_BACKEND=smtp                          # smtp (production) | console (dev: logs codes) | memory (tests)
EMAIL_VERIFICATION_TTL_HOURS=24
PUBLIC_BASE_URL=https://auth.CHANGE_ME.example   # public URL of this server, used in email links
# Any SMTP provider works. Example (Brevo): host smtp-relay.brevo.com, port 587,
# username = your Brevo SMTP login, password = a Brevo SMTP key (not your account password).
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=DedSec CCTV <no-reply@CHANGE_ME.example>   # must be a sender verified with your provider
SMTP_STARTTLS=true
SMTP_SSL=false                              # true for implicit TLS (port 465); then SMTP_STARTTLS=false

# --- device (HWID) lock ---
DEVICE_LOCK_REQUIRE_HWID=true
DEVICE_RESET_TTL_MINUTES=15
DEVICE_RESET_MAX_ATTEMPTS=5
DEVICE_RESET_EMAILS_PER_HOUR=3

# --- HTTP hardening (lists are JSON arrays) ---
CORS_ORIGINS=[]                             # desktop clients need none; "*" is rejected
ALLOWED_HOSTS=["auth.CHANGE_ME.example","localhost","127.0.0.1"]
FORCE_HTTPS=false                           # TLS is normally terminated by Caddy
ENABLE_DOCS=false                           # /docs is never served in production

# HMAC key for product-update unsubscribe tokens (>= 32 random bytes). Empty disables prefs links.
EMAIL_UNSUB_KEY=

# Branding / product links (used in transactional emails and prefs pages)
EMAIL_ASSET_BASE=https://auth.example.com/updates/email/
SUPPORT_EMAIL=support@example.com
DISCORD_URL=
GITHUB_URL=https://github.com/QuacksOnWelfare/DedSecCCTV

# Refuse logins from app builds older than this semver (empty = disabled)
MIN_APP_VERSION=
