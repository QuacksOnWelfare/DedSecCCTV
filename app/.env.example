# Same settings as config.ini.example, as environment variables (set them before running app.py).
DEDSEC_API_URL=https://auth.example.com
DEDSEC_UPDATE_URL=https://auth.example.com/updates/
DEDSEC_BLOCKED_IPS=
# Local development only:
# DEDSEC_DEV=1            allow http:// to 127.0.0.1/localhost
# DEDSEC_NO_UPDATE=1      (with DEDSEC_DEV=1) skip the update check
